# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# ---------------------------------------------------------------------------
# MIGRATION_DATABASE_URL — the POSTGRES CONNECTION STRING.
#
# This is NOT the project URL (https://<ref>.supabase.co). That is the API
# endpoint and cannot be used to connect to the database.
#
# Supabase dashboard -> your project -> "Connect" (top bar)
#   -> Connection string -> Session pooler   <-- port 5432, this one
#
# Session pooler (5432), NOT transaction pooler (6543): these scripts run long
# transactions and prepared statements, which transaction mode does not
# support. The app itself will use 6543 later; the tooling uses 5432.
#
# Also not db.<ref>.supabase.co:5432 — the direct host is IPv6-only on the
# free tier and unreachable from most networks.
#
# Replace [YOUR-PASSWORD] with the database password. If you don't have it:
#   Project Settings -> Database -> Reset database password.
# ---------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Local Docker Postgres, for exercising the tooling without touching live data:
# docker run -d --name kora-pg -e POSTGRES_PASSWORD=postgres -p 55432:5432 postgres:16
# MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres

# ---------------------------------------------------------------------------
# OPTION B — read-only access via PostgREST.
#
# Enough to run `pnpm migrate:preflight`, which is the item with the longest
# human lead time (the data-cleanup list is work someone has to do in the old
# app before cutover). NOT enough for the migration itself: PostgREST has no
# transactions, no TRUNCATE and no DDL, and the backfill is deliberately one
# all-or-nothing transaction.
#
# Both values already exist in the old app's Vercel project:
#   Vercel -> kora project -> Settings -> Environment Variables
# or Supabase -> Project Settings -> API.
#
# The service-role key bypasses row-level security entirely. Treat it as being
# exactly as sensitive as the database password.
#
# If MIGRATION_DATABASE_URL is also set, it takes precedence.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key>
